{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pyxeldreambyte.github.io/LitRPG-Novel/governance/schemas/decision-record.schema.json",
  "title": "Author decision record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "decision_uri",
    "display_code",
    "title",
    "domain",
    "workflow_status",
    "canon_status",
    "scope",
    "question",
    "selection",
    "alternatives",
    "rationale",
    "evidence",
    "consequences",
    "affected_sources",
    "dependencies",
    "conflicts",
    "residual_unknowns",
    "supersedes",
    "reopening_conditions"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:[.-][A-Z0-9]+)*$"},
    "decision_uri": {"type": "string", "pattern": "^author-decision://[^\\s]+$"},
    "display_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:[.-][A-Z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "setting_id": {"type": "string", "pattern": "^setting://[^\\s]+$"},
    "workflow_status": {
      "enum": ["DRAFT", "IN_REVIEW", "AWAITING_AUTHOR", "ACCEPTED", "REJECTED", "SUPERSEDED"]
    },
    "canon_status": {
      "enum": ["ACCEPTED", "PROVISIONAL", "PROPOSED", "DEFERRED", "REJECTED", "SUPERSEDED"]
    },
    "scope": {"type": "string", "minLength": 1},
    "accepted_on": {"type": "string", "format": "date"},
    "accepted_by": {"const": "Author"},
    "approval_evidence": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "selection": {"type": "string", "minLength": 1},
    "alternatives": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "rationale": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "consequences": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "affected_sources": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "conflicts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "residual_unknowns": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "supersedes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "superseded_by": {
      "anyOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "reopening_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"workflow_status": {"const": "ACCEPTED"}}, "required": ["workflow_status"]},
      "then": {"required": ["accepted_on", "accepted_by", "approval_evidence"]}
    },
    {
      "if": {
        "properties": {
          "canon_status": {"enum": ["ACCEPTED", "PROVISIONAL", "DEFERRED", "REJECTED"]}
        },
        "required": ["canon_status"]
      },
      "then": {"required": ["accepted_on", "accepted_by", "approval_evidence"]}
    },
    {
      "oneOf": [
        {
          "properties": {
            "workflow_status": {"enum": ["DRAFT", "IN_REVIEW", "AWAITING_AUTHOR"]},
            "canon_status": {"const": "PROPOSED"}
          }
        },
        {
          "properties": {
            "workflow_status": {"const": "ACCEPTED"},
            "canon_status": {"enum": ["ACCEPTED", "PROVISIONAL", "DEFERRED"]}
          }
        },
        {
          "properties": {
            "workflow_status": {"const": "REJECTED"},
            "canon_status": {"const": "REJECTED"}
          }
        },
        {
          "properties": {
            "workflow_status": {"const": "SUPERSEDED"},
            "canon_status": {"const": "SUPERSEDED"}
          }
        }
      ]
    }
  ]
}
