{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pyxeldreambyte.github.io/LitRPG-Novel/governance/schemas/worldbuilding-record.schema.json",
  "title": "Worldbuilding canon record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "record_uri",
    "display_code",
    "setting_id",
    "title",
    "workflow_status",
    "canon_status",
    "scope",
    "claims",
    "boundaries",
    "dependencies",
    "contradictions",
    "story_implications",
    "system_implications",
    "research_questions",
    "sources",
    "supersedes"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^WLD(?:[.-][A-Z0-9]+)+$"},
    "record_uri": {"type": "string", "pattern": "^canon://world/[^\\s]+$"},
    "display_code": {"type": "string", "pattern": "^WLD(?:[.-][A-Z0-9]+)+$"},
    "setting_id": {"type": "string", "pattern": "^setting://[^\\s]+$"},
    "title": {"type": "string", "minLength": 1},
    "workflow_status": {
      "enum": ["DRAFT", "IN_REVIEW", "AWAITING_AUTHOR", "ACCEPTED", "REJECTED", "SUPERSEDED"]
    },
    "canon_status": {
      "enum": ["ACCEPTED", "PROVISIONAL", "PROPOSED", "DEFERRED", "REJECTED", "SUPERSEDED"]
    },
    "scope": {"type": "string", "minLength": 1},
    "claims": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "boundaries": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "contradictions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "story_implications": {"type": "array", "items": {"type": "string"}},
    "system_implications": {"type": "array", "items": {"type": "string"}},
    "research_questions": {"type": "array", "items": {"type": "string"}},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "supersedes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "superseded_by": {
      "anyOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "author_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_uri", "accepted_on", "accepted_by", "evidence"],
      "properties": {
        "decision_uri": {"type": "string", "pattern": "^author-decision://[^\\s]+$"},
        "accepted_on": {"type": "string", "format": "date"},
        "accepted_by": {"const": "Author"},
        "evidence": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "canon_status": {"enum": ["ACCEPTED", "PROVISIONAL", "DEFERRED"]}
        },
        "required": ["canon_status"]
      },
      "then": {"required": ["author_approval"]}
    },
    {
      "oneOf": [
        {
          "properties": {
            "workflow_status": {"enum": ["DRAFT", "IN_REVIEW", "AWAITING_AUTHOR"]},
            "canon_status": {"const": "PROPOSED"}
          }
        },
        {
          "properties": {
            "workflow_status": {"const": "ACCEPTED"},
            "canon_status": {"enum": ["ACCEPTED", "PROVISIONAL", "DEFERRED"]}
          }
        },
        {
          "properties": {
            "workflow_status": {"const": "REJECTED"},
            "canon_status": {"const": "REJECTED"}
          }
        },
        {
          "properties": {
            "workflow_status": {"const": "SUPERSEDED"},
            "canon_status": {"const": "SUPERSEDED"}
          }
        }
      ]
    }
  ]
}
