{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pyxeldreambyte.invalid/litrpg-novel/governance/worldbuilding-record.schema.json",
  "title": "Worldbuilding record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "record_uri",
    "title",
    "workflow_status",
    "canon_status",
    "scope",
    "claims",
    "dependencies",
    "story_implications",
    "system_implications",
    "sources"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^WLD(?:[.-][A-Z0-9]+)+$"},
    "record_uri": {"type": "string", "pattern": "^canon://world/[^\\s]+$"},
    "title": {"type": "string", "minLength": 1},
    "workflow_status": {
      "enum": ["DRAFT", "IN_REVIEW", "AWAITING_AUTHOR", "ACCEPTED", "REJECTED", "SUPERSEDED"]
    },
    "canon_status": {
      "enum": ["ACCEPTED", "PROVISIONAL", "PROPOSED", "DEFERRED", "REJECTED", "SUPERSEDED"]
    },
    "scope": {"type": "string", "minLength": 1},
    "claims": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "contradictions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "story_implications": {"type": "array", "items": {"type": "string"}},
    "system_implications": {"type": "array", "items": {"type": "string"}},
    "research_questions": {"type": "array", "items": {"type": "string"}},
    "sources": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "author_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_uri", "accepted_on", "accepted_by", "evidence"],
      "properties": {
        "decision_uri": {"type": "string", "pattern": "^author-decision://[^\\s]+$"},
        "accepted_on": {"type": "string", "format": "date"},
        "accepted_by": {"const": "Author"},
        "evidence": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"canon_status": {"const": "ACCEPTED"}}, "required": ["canon_status"]},
      "then": {"required": ["author_approval"]}
    }
  ]
}
