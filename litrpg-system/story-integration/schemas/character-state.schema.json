{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pyxeldreambyte.github.io/LitRPG-Novel/schemas/character-state.schema.json",
  "title": "Materialised character state",
  "type": "object",
  "required": [
    "schema_version",
    "snapshot_id",
    "character_id",
    "as_of_chapter_id",
    "as_of_event_sequence",
    "derived_from_delta_ids",
    "location_id",
    "attributes",
    "resources",
    "progression",
    "traits",
    "achievements",
    "inventory",
    "conditions",
    "knowledge"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "snapshot_id": {"$ref": "story-common.schema.json#/$defs/identifier"},
    "character_id": {"$ref": "story-common.schema.json#/$defs/identifier"},
    "as_of_chapter_id": {"$ref": "story-common.schema.json#/$defs/identifier"},
    "as_of_event_sequence": {"type": "integer", "minimum": 0},
    "derived_from_delta_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "story-common.schema.json#/$defs/identifier"}
    },
    "location_id": {"$ref": "story-common.schema.json#/$defs/identifier"},
    "attributes": {
      "type": "object",
      "additionalProperties": {"$ref": "story-common.schema.json#/$defs/exactDecimal"}
    },
    "resources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["current", "capacity"],
        "properties": {
          "current": {"$ref": "story-common.schema.json#/$defs/exactDecimal"},
          "capacity": {"$ref": "story-common.schema.json#/$defs/exactDecimal"}
        },
        "additionalProperties": false
      }
    },
    "progression": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "track_id", "level", "xp"],
        "properties": {
          "kind": {"enum": ["SKILL", "CLASS"]},
          "track_id": {"type": "string", "minLength": 1},
          "lineage_id": {"type": "string", "minLength": 1},
          "level": {"$ref": "story-common.schema.json#/$defs/nonNegativeDecimal"},
          "xp": {"$ref": "story-common.schema.json#/$defs/nonNegativeDecimal"}
        },
        "additionalProperties": false
      }
    },
    "traits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["trait_id", "status", "provenance_refs"],
        "properties": {
          "trait_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["DORMANT", "ACTIVE", "SUPPRESSED", "LOST"]},
          "provenance_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["achievement_id", "acquired_event_id", "provenance_refs"],
        "properties": {
          "achievement_id": {"type": "string", "minLength": 1},
          "acquired_event_id": {"$ref": "story-common.schema.json#/$defs/identifier"},
          "provenance_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item_id", "quantity", "provenance_refs"],
        "properties": {
          "item_id": {"$ref": "story-common.schema.json#/$defs/identifier"},
          "quantity": {"$ref": "story-common.schema.json#/$defs/nonNegativeDecimal"},
          "provenance_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["condition_id", "severity", "source_event_id"],
        "properties": {
          "condition_id": {"type": "string", "minLength": 1},
          "severity": {"$ref": "story-common.schema.json#/$defs/nonNegativeDecimal"},
          "source_event_id": {"$ref": "story-common.schema.json#/$defs/identifier"}
        },
        "additionalProperties": false
      }
    },
    "knowledge": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fact_id", "certainty", "source_refs"],
        "properties": {
          "fact_id": {"type": "string", "minLength": 1},
          "certainty": {"enum": ["KNOWN", "BELIEVED", "SUSPECTED", "DISPROVED"]},
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "story-common.schema.json#/$defs/sourceReference"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
