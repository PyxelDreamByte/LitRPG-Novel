{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://cal0/i3-reference-scenarios@1",
  "title": "CAL0-I3 comparison characters and reference scenarios",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "version",
    "lifecycle",
    "canonicality",
    "parameter_set_id",
    "characters",
    "scenarios",
    "separation_contract"
  ],
  "properties": {
    "registry_id": {"const": "registry://cal0/i3-reference-scenarios@1"},
    "version": {"const": "1"},
    "lifecycle": {"const": "ACTIVE"},
    "canonicality": {"const": "REFERENCE_ONLY_NOT_STORY_CANON"},
    "parameter_set_id": {"type": "string"},
    "characters": {"type": "array", "minItems": 4, "items": {"type": "object"}},
    "scenarios": {"type": "array", "minItems": 5, "items": {"type": "object"}},
    "separation_contract": {"type": "string", "minLength": 1}
  }
}
