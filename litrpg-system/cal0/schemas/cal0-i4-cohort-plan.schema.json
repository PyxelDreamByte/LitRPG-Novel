{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://cal0/i4-cohort-plan@1",
  "title": "CAL0-I4 cohort calibration plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cohort_plan_id",
    "canonicality",
    "parameter_parent",
    "births_per_seed",
    "seeds",
    "life_stage_coordinates",
    "environments",
    "trial_inputs",
    "calibration_iterations",
    "envelopes",
    "comparison_ensembles",
    "sensitivity",
    "required_outputs",
    "expected_checks",
    "provenance"
  ],
  "properties": {
    "cohort_plan_id": {"const": "cohort-plan://cal0/i4-human-reference@1"},
    "canonicality": {"const": "INTERNAL_WORLD_CALIBRATION_NOT_EMPIRICAL_FACT"},
    "parameter_parent": {"const": "parameter-set://cal0/i3-reference@1"},
    "births_per_seed": {"type": "integer", "minimum": 10000},
    "seeds": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "integer"}},
    "life_stage_coordinates": {"type": "object"},
    "environments": {"type": "array", "minItems": 3},
    "trial_inputs": {"type": "object"},
    "calibration_iterations": {"type": "array", "minItems": 2},
    "envelopes": {"type": "array", "minItems": 1},
    "comparison_ensembles": {"type": "array", "minItems": 5},
    "sensitivity": {"type": "object"},
    "required_outputs": {"type": "array", "minItems": 1, "uniqueItems": true},
    "expected_checks": {"type": "array", "minItems": 1, "uniqueItems": true},
    "provenance": {"type": "array", "minItems": 1}
  }
}
