{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema://cal0/i7-sheet-projection@1",
  "title": "CAL0-I7 scoped character-sheet projection",
  "type": "object",
  "required": ["sheet_id", "view_kind", "source_sheet_digest", "view_digest"],
  "properties": {
    "sheet_id": {"type": "string", "pattern": "^sheet://cal0/i6/[a-z0-9-]+@1$"},
    "view_kind": {
      "enum": ["private_backend", "author_facing", "character_accessible", "appraisal_derived", "institutional_record", "reader_facing"]
    },
    "source_sheet_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "view_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {"properties": {"view_kind": {"const": "author_facing"}}},
      "then": {"required": ["identity", "attributes", "resources", "progression", "causal_ledgers", "author_notes"]}
    },
    {
      "if": {"properties": {"view_kind": {"const": "character_accessible"}}},
      "then": {"required": ["identity", "attributes", "resources", "progression", "access_basis"]}
    },
    {
      "if": {"properties": {"view_kind": {"const": "appraisal_derived"}}},
      "then": {"required": ["identity", "confidence", "scope", "omissions_are_not_negative_facts"]}
    },
    {
      "if": {"properties": {"view_kind": {"const": "institutional_record"}}},
      "then": {"required": ["identity", "verified_progression", "record_scope", "record_is_not_omniscient"]}
    },
    {
      "if": {"properties": {"view_kind": {"const": "reader_facing"}}},
      "then": {"required": ["name", "life_stage", "summary", "exact_backend_withheld"]}
    }
  ]
}
